# Public canonical fallback, used during the Next export. Domain ownership is not assumed.
NEXT_PUBLIC_SITE_URL=

# Server/Worker values only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=

# Enable only after an SMS provider and existing Auth phone identities are configured.
PHONE_OTP_ENABLED=false

# Optional enquiry spam check. Set both keys together. Secret remains server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
